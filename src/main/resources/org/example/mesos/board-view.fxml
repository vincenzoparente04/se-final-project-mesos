<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
           fx:controller="view.BoardViewController">

    <BorderPane>

        <!-- Top: status bar + other players bar (kept above the play area so they can't overlap the rows) -->
        <top>
            <VBox>
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="mesos-status-bar">
                    <Label fx:id="phaseLabel"      styleClass="mesos-label-bold"/>
                    <Label fx:id="roundLabel"      styleClass="mesos-label"/>
                    <Label fx:id="eraLabel"        styleClass="mesos-label"/>
                    <Label text="•" styleClass="mesos-label"/>
                    <Label fx:id="currentPlayerLabel" styleClass="mesos-label-glow"/>
                    <Label text="" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="endTurnButton" text="End turn" onAction="#onEndTurn"
                            visible="false" managed="false"
                            styleClass="mesos-button"/>
                </HBox>

                <HBox fx:id="othersBar" alignment="CENTER" spacing="18"
                      styleClass="mesos-other-players-bar"/>
            </VBox>
        </top>

        <!-- Center: board play area -->
        <center>
            <BorderPane styleClass="mesos-board-area">
                <center>
                    <VBox fx:id="boardBox" spacing="14" alignment="CENTER"
                          style="-fx-padding: 18 20 18 20;">
                        <!-- Upper rows: tribe top + building top -->
                        <HBox fx:id="upperRowsBox" spacing="40" alignment="CENTER"/>

                        <!-- Central core: TurnOrderTile + OfferTrack stacked -->
                        <VBox fx:id="centralBox" spacing="10" alignment="CENTER"/>

                        <!-- Lower rows: tribe bottom + building bottom -->
                        <HBox fx:id="lowerRowsBox" spacing="40" alignment="CENTER"/>
                    </VBox>
                </center>
                <right>
                    <VBox fx:id="decksBox" spacing="20" alignment="CENTER"
                          style="-fx-padding: 24 24 24 12;"/>
                </right>
            </BorderPane>
        </center>

        <!-- Bottom: self player + own tribe -->
        <bottom>
            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="mesos-self-bar">
                <StackPane fx:id="selfPlayerSlot"/>
                <VBox spacing="4">
                    <Label text="Your tribe" styleClass="mesos-section-label"/>
                    <HBox fx:id="selfTribeSlot" spacing="14" alignment="CENTER_LEFT"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Your buildings" styleClass="mesos-section-label"/>
                    <HBox fx:id="selfBuildingsSlot" spacing="6" alignment="CENTER_LEFT"/>
                </VBox>
                <Label text="" HBox.hgrow="ALWAYS"/>
                <HBox fx:id="colorPicker" alignment="CENTER" spacing="8"
                      visible="false" managed="false"/>
            </HBox>
        </bottom>

    </BorderPane>

</StackPane>
