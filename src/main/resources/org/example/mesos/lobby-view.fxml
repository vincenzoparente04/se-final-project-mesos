<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
           fx:controller="view.LobbyViewController"
           style="-fx-background-color: #1a1a1a;">

    <BorderPane>

        <top>
            <VBox alignment="CENTER" spacing="4" style="-fx-padding: 18 0 14 0;">
                <Label text="MESOS"
                       style="-fx-text-fill: #ecf0f1; -fx-font-size: 26; -fx-font-weight: bold; -fx-letter-spacing: 4;"/>
                <Label fx:id="playerNameLabel"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 12;"/>
            </VBox>
        </top>

        <center>
            <VBox spacing="10" style="-fx-padding: 0 60 0 60;">
                <Label text="Open lobbies"
                       style="-fx-text-fill: #bdc3c7; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <ListView fx:id="lobbyListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #2c3e50;
                                 -fx-control-inner-background: #2c3e50;
                                 -fx-text-fill: white;"/>
                <Label fx:id="statusLabel"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 11;"/>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="14" style="-fx-padding: 18;">
                <Button text="Refresh" onAction="#onRefresh"
                        style="-fx-padding: 8 18 8 18;"/>
                <Button text="Create new lobby" onAction="#onCreate"
                        style="-fx-padding: 8 18 8 18;
                               -fx-background-color: #27ae60;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>
            </HBox>
        </bottom>

        <padding>
            <Insets top="0" right="0" bottom="0" left="0"/>
        </padding>

    </BorderPane>

</StackPane>
