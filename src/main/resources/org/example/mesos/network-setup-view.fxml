<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
           fx:controller="view.NetworkSetupViewController">

    <VBox alignment="CENTER" spacing="26" maxWidth="440">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="MESOS" styleClass="mesos-title-medium"/>

        <GridPane hgap="14" vgap="14">
            <Label text="Host" styleClass="mesos-label-bold"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="hostField" text="localhost"
                       styleClass="mesos-textfield"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Port" styleClass="mesos-label-bold"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="portField" text="1099"
                       styleClass="mesos-textfield"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Transport" styleClass="mesos-label-bold"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <HBox spacing="14"
                  GridPane.rowIndex="2" GridPane.columnIndex="1">
                <fx:define>
                    <ToggleGroup fx:id="transportGroup"/>
                </fx:define>
                <RadioButton fx:id="rmiRadio" text="RMI" selected="true"
                             toggleGroup="$transportGroup"
                             styleClass="mesos-radio"/>
                <RadioButton fx:id="socketRadio" text="Socket"
                             toggleGroup="$transportGroup"
                             styleClass="mesos-radio"/>
            </HBox>
        </GridPane>

        <Button fx:id="connectButton" text="Connect" onAction="#onConnect"
                defaultButton="true" styleClass="mesos-button"/>

        <Label fx:id="statusLabel" styleClass="mesos-hint"/>
    </VBox>

</StackPane>
