<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="view.PlayerViewController">
    <VBox alignment="CENTER" spacing="4" styleClass="mesos-player-marker">
        <StackPane fx:id="totemSlot"/>
        <Label fx:id="nameLabel" styleClass="mesos-player-name"/>
        <HBox alignment="CENTER" spacing="10">
            <Label fx:id="foodLabel" styleClass="mesos-player-food"/>
            <Label fx:id="ppLabel"   styleClass="mesos-player-pp"/>
        </HBox>
        <FlowPane fx:id="chipsBar" hgap="4" vgap="4" alignment="CENTER" prefWrapLength="180"/>
    </VBox>
</StackPane>
