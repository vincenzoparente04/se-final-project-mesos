<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
           fx:controller="view.SplashViewController">

    <VBox alignment="CENTER" spacing="22">
        <Label text="MESOS" styleClass="mesos-title"/>
        <Label fx:id="hintLabel" text="click anywhere to start"
               styleClass="mesos-hint"/>
    </VBox>

</StackPane>
