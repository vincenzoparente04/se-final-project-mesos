<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Root is a StackPane so the game-over overlay can sit on top of the BorderPane.
  All children of a StackPane are layered: BorderPane (bottom) + gameOverPane (top).
-->
<StackPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
           fx:controller="view.GameViewController">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  Main game layout                                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <BorderPane>

        <!-- TOP: status bar -->
        <top>
            <HBox spacing="16" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
                <Label fx:id="phaseLabel"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
                <Label fx:id="roundLabel" style="-fx-text-fill: #aaaaaa;"/>
                <Label fx:id="eraLabel" style="-fx-text-fill: #aaaaaa;"/>
                <Label text="|" style="-fx-text-fill: #555555;"/>
                <Label fx:id="currentPlayerLabel" style="-fx-text-fill: #f1c40f; -fx-font-weight: bold;"/>
                <Label text="'s turn"  style="-fx-text-fill: #aaaaaa;"/>
            </HBox>
        </top>

        <!-- LEFT: players panel -->
        <left>
            <VBox fx:id="playersPanel" spacing="8" prefWidth="190"
                  style="-fx-background-color: #ecf0f1; -fx-padding: 10;">
                <Label text="Players" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
            </VBox>
        </left>

        <!-- CENTER: board + cards -->
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                <content>
                    <VBox spacing="10" style="-fx-padding: 12;">

                        <!-- Color-choosing overlay (shown only when it's my turn to pick) -->
                        <VBox fx:id="colorChoiceBox" spacing="8" visible="false" managed="false"
                              style="-fx-background-color: #fef9e7; -fx-padding: 10;
                                     -fx-border-color: #f39c12; -fx-border-width: 1;">
                            <Label text="Choose your totem's color:"
                                   style="-fx-font-weight: bold;"/>
                            <HBox fx:id="colorButtonsBox" spacing="8"/>
                        </VBox>

                        <!-- Offer Track -->
                        <VBox spacing="4">
                            <Label text="Offer Track"
                                   style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                            <HBox fx:id="offerTrackBox" spacing="10"/>
                        </VBox>

                        <!-- Turn Order -->
                        <VBox spacing="4">
                            <Label text="Turn order"
                                   style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                            <HBox fx:id="turnOrderBox" spacing="8"/>
                        </VBox>

                        <Separator/>

                        <!-- Tribe rows -->
                        <Label text="Tribe — Upper row" style="-fx-font-weight: bold;"/>
                        <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" prefHeight="150">
                            <content>
                                <HBox fx:id="topTribeBox" spacing="6" style="-fx-padding: 4;"/>
                            </content>
                        </ScrollPane>

                        <Label text="Tribe — Lower row" style="-fx-font-weight: bold;"/>
                        <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" prefHeight="150">
                            <content>
                                <HBox fx:id="bottomTribeBox" spacing="6" style="-fx-padding: 4;"/>
                            </content>
                        </ScrollPane>

                        <!-- Building rows -->
                        <Label text="Building — Upper row" style="-fx-font-weight: bold;"/>
                        <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" prefHeight="150">
                            <content>
                                <HBox fx:id="topBuildingBox" spacing="6" style="-fx-padding: 4;"/>
                            </content>
                        </ScrollPane>

                        <Label text="Building — Lower row" style="-fx-font-weight: bold;"/>
                        <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" prefHeight="150">
                            <content>
                                <HBox fx:id="bottomBuildingBox" spacing="6" style="-fx-padding: 4;"/>
                            </content>
                        </ScrollPane>

                    </VBox>
                </content>
            </ScrollPane>
        </center>

        <!-- BOTTOM: action bar -->
        <bottom>
            <HBox spacing="12" alignment="CENTER_RIGHT"
                  style="-fx-background-color: #bdc3c7; -fx-padding: 10;">
                <Label fx:id="actionInfoLabel" text=""/>
                <Button fx:id="endTurnButton" text="End turn" onAction="#onEndTurn"
                        visible="false" managed="false"/>
            </HBox>
        </bottom>

    </BorderPane>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  Game-over overlay (sits on top of BorderPane)             -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <StackPane fx:id="gameOverPane" visible="false"
               style="-fx-background-color: rgba(0, 0, 0, 0.72);">
        <VBox alignment="CENTER" spacing="16"
              style="-fx-background-color: white; -fx-padding: 48;
                     -fx-background-radius: 8; -fx-border-radius: 8;"
              maxWidth="420">
            <Label text="GAME OVER"
                   style="-fx-font-size: 22; -fx-font-weight: bold;"/>
            <Label fx:id="winnersLabel"
                   style="-fx-font-size: 15; -fx-wrap-text: true;" wrapText="true"/>
        </VBox>
    </StackPane>

</StackPane>
