<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration focused on Javadoc coverage.
    Checks public and protected types, methods, and constructors.
    Run with: mvn verify  →  report at target/site/checkstyle.html
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">

        <!-- Missing Javadoc on types: classes, interfaces, enums, records -->
        <module name="MissingJavadocType">
            <property name="scope" value="protected"/>
        </module>

        <!-- Missing Javadoc on methods and constructors -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="protected"/>
            <!-- Skip trivial getters/setters (e.g. getFoo / setFoo / isFoo) -->
            <property name="allowMissingPropertyJavadoc" value="true"/>
        </module>

    </module>
</module>